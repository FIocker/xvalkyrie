# Script mode: writes OUTPUT with the version string shown by the windows and --version.
# Needs -DSOURCE_DIR, -DOUTPUT and -DVERSION. Runs on every build so the commit stays current.
set(commit "")
set(tag "")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --always --dirty --abbrev=8 --exclude "*"
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --tags --exact-match --match "v[0-9]*" --match "[0-9]*"
    OUTPUT_VARIABLE tag OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  # a tag is the version with or without a v before it; it is shown with one
  if(tag AND NOT tag MATCHES "^v")
    set(tag "v${tag}")
  endif()
endif()
if(tag AND commit)
  set(release "${tag}")
else()
  set(release "v${VERSION}-dev")
endif()
if(commit)
  set(text "${release} (${commit})")
else()
  set(text "${release} (no git commit)")
endif()
# the commit alone, without the mark of a tree with changes: for the title window's caption
string(REGEX REPLACE "-dirty$" "" hash "${commit}")
set(content "#pragma once\n\nnamespace xv {\ninline constexpr char version[] = \"${text}\";\ninline constexpr char release[] = \"${release}\";\ninline constexpr char commit[] = \"${hash}\";\n} // namespace xv\n")
set(previous "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
endif()
if(NOT content STREQUAL previous)
  file(WRITE "${OUTPUT}" "${content}")
endif()
