# Script mode: writes OUTPUT, a C++ file with the bytes of INPUT in `const unsigned char
# NAME[]` and their count in `const unsigned int NAME_size`. Needs -DINPUT, -DOUTPUT, -DNAME.
file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" digits)
math(EXPR count "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" bytes "${bytes}")
file(WRITE "${OUTPUT}" "// Generated by cmake/Embed.cmake from ${NAME}; do not edit.
extern const unsigned char ${NAME}[];
extern const unsigned int ${NAME}_size;
const unsigned char ${NAME}[] = {
${bytes}};
const unsigned int ${NAME}_size = ${count};
")
